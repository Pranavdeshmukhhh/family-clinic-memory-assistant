# Family Clinic Memory Assistant — Environment Configuration
# Copy this file to .env and configure as needed.
# NEVER commit your .env file to version control.

# ==============================================================================
# RUNTIME MODE
# ==============================================================================
# Set DEMO_MODE=true for zero-setup evaluation without real API keys.
# In DEMO_MODE:
#   - Hindsight memory calls fall back to safe local handling
#   - Groq calls fall back to deterministic clinical rule engine
#   - Three demo users (doctor_demo, pharmacist_demo, owner_demo) are seeded
#   - JWT_SECRET validation is bypassed
# For live production / cloud services, set to false and provide real keys below.
DEMO_MODE=true

# ==============================================================================
# HINDSIGHT PERSISTENT MEMORY (Required if DEMO_MODE=false)
# ==============================================================================
# Sign up at https://vectorize.io / Hindsight
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# ==============================================================================
# GROQ LLM REASONING (Optional — built-in clinical rule engine is used if absent)
# ==============================================================================
# Get a key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ==============================================================================
# AUTHENTICATION & SECURITY (Required if DEMO_MODE=false)
# ==============================================================================
# Generate a secure 32+ byte random hex string:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-or-use-demo-mode
JWT_EXPIRE_HOURS=24

# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Rate limiting toggle (true in production, false for high-concurrency benchmarks)
RATELIMIT_ENABLED=true

# ==============================================================================
# DATABASE
# ==============================================================================
DB_PATH=clinic.db

# ==============================================================================
# TELEGRAM RESTOCK ALERTS (Optional — both required to enable push alerts)
# ==============================================================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

