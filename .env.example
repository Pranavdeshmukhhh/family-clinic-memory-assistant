# Copy to .env and fill in real values.
# Never commit .env — it is listed in .gitignore.

# Required (unless DEMO_MODE=true)
HINDSIGHT_API_KEY=your_hindsight_api_key_here
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io

# Optional — fallback rule engine is used when absent
GROQ_API_KEY=your_groq_api_key_here

# Optional — Telegram low-stock alerts (both values required to enable)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Set to true to run without any API keys (memory is a no-op)
# DEMO_MODE=true
